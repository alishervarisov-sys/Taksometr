rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - allow read for login verification
    match /users/{userId} {
      allow read: if true;
      allow create: if false; // Only via Cloud Functions
      allow update: if true; // Validated in Cloud Functions
      allow delete: if true; // Admin can delete couriers

      // Per-courier progressive commission ladder steps.
      // The admin panel reads them; only Cloud Functions write them.
      match /commissionTiers/{tierId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Deliveries collection
    match /deliveries/{deliveryId} {
      allow read: if true;
      allow create: if true; // Created via Cloud Functions
      allow update: if true; // Validated in Cloud Functions
      allow delete: if false; // Never delete completed deliveries from client
    }

    // Tariffs collection
    match /tariffs/{tariffId} {
      allow read: if true;
      allow write: if false; // Only via Cloud Functions (updateTariff)
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if false; // Only via admin Cloud Functions
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Winner-of-the-month announcements
    match /winner_announcements/{announcementId} {
      allow read: if true;      // Couriers read to show the congratulation
      allow write: if false;    // Only via Cloud Functions (announceWinner)
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if true;
      allow create: if false; // Only via Cloud Functions
      allow update: if false;
      allow delete: if false;
    }

    // Taxi orders collection
    match /taxi_orders/{orderId} {
      allow read: if true;
      allow create: if false; // Only via Cloud Functions (createTaxiOrder)
      allow update: if true;  // Cloud Functions + admin panel status updates
      allow delete: if false;
    }

    // Taxi drivers collection
    match /taxiDrivers/{driverId} {
      allow read: if true;
      allow create: if false; // Only via Cloud Functions (registration)
      allow update: if true;  // Cloud Functions + admin panel approve/block
      allow delete: if false;
    }

    // Taxi registration sessions (bot registration flow)
    match /taxiRegistrationSessions/{sessionId} {
      allow read: if true;
      allow write: if true; // Managed by Cloud Functions bot
    }

    // Taxi audit log
    match /taxiAuditLog/{entryId} {
      allow read: if true;
      allow create: if false; // Only via Cloud Functions
      allow update: if false;
      allow delete: if false;
    }

    // Continuous courier location breadcrumbs (the "Трекинг" feature).
    // The courier app appends points; the admin panel reads them; old points are
    // auto-removed by the Firestore TTL policy on `expireAt`.
    match /courier_tracks/{courierId} {
      allow read, write: if true;
      match /points/{pointId} {
        allow read: if true;       // Admin panel reads a courier's route
        allow create: if true;     // Courier app appends breadcrumbs
        allow update: if false;
        allow delete: if true;     // Manual/TTL cleanup
      }
    }
  }
}
