{
  "name": "zaki-taksometr-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for ZaKi Taksometr",
  "scripts": {
    "build": "tsc",
    "test:dispatch": "npm run build && node lib/dispatch/dispatch-self-test.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^5.1.1",
    "h3-js": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  },
  "private": true
}
