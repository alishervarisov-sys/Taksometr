<Window x:Class="ZaKi.Dispatcher.FullAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ZaKi Admin — Windows 1.3.0"
        Icon="Assets/zaki.ico"
        Width="1500" Height="900" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PrimaryDarkBrush}" Padding="15,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource PrimaryLightBrush}">
                        <TextBlock Text="Z" FontSize="19" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ZaKi Admin • 1.3.0" Foreground="White"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="StateText" Grid.Column="1" Text="Локальная панель загружается…"
                           Foreground="#D9E8FF" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Проверить уведомления" Background="#70ABFF" Foreground="White"
                            Margin="0,0,9,0" Click="TestNotifications_Click" />
                    <Button Content="Локальные заказы" Background="#70ABFF" Foreground="White"
                            Margin="0,0,9,0" Click="OpenNativeOrders_Click" />
                    <Button Content="Обновить панель" Background="{StaticResource PrimaryLightBrush}" Foreground="{StaticResource PrimaryDarkBrush}"
                            Margin="0,0,9,0" Click="Reload_Click" />
                    <Button Content="Сменить аккаунт" Background="Transparent" Foreground="White"
                            BorderBrush="#A9C9FA" BorderThickness="1" Click="SwitchAccount_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="AdminWebView" Visibility="Hidden" />
            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="320" Height="7" IsIndeterminate="True" Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Text="Запуск всех модулей ZaKi Admin…" Margin="0,16,0,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="15" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
