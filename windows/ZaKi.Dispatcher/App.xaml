<Application x:Class="ZaKi.Dispatcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3786F6" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1E64C8" />
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#E8F2FF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PageBrush" Color="#F4F8FF" />
        <SolidColorBrush x:Key="TextBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#D6E4F7" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="BorderBrush" Value="#D6E4F7" />
        </Style>
    </Application.Resources>
</Application>
