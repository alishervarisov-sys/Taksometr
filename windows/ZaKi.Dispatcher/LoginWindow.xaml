<Window x:Class="ZaKi.Dispatcher.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZaKi Dispatcher — Вход"
        Icon="Assets/zaki.ico"
        Width="460" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource PageBrush}">
    <Grid>
        <Border Width="370" Padding="34" Background="White" CornerRadius="22"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <Border Width="72" Height="72" CornerRadius="20" Background="{StaticResource PrimaryBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="Z" FontSize="38" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="ZaKi Dispatcher" FontSize="27" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Рабочее место диспетчера" FontSize="14" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,5,0,28" />

                <TextBlock Text="Логин" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="LoginBox" Height="42" FontSize="15" />
                <TextBlock Text="Пароль" Foreground="{StaticResource TextBrush}" Margin="0,18,0,6" />
                <PasswordBox x:Name="PasswordBox" Height="42" FontSize="15" Padding="10,8"
                             KeyDown="PasswordBox_KeyDown" />

                <TextBlock x:Name="ErrorText" Foreground="#B3261E" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,14,0,0" />
                <Button x:Name="LoginButton" Content="Войти" Height="46" Margin="0,24,0,0"
                        Background="{StaticResource PrimaryBrush}" Foreground="White" Click="LoginButton_Click" />
                <TextBlock Text="Для первого входа требуется интернет" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
